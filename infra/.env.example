# Copy to infra/.env (git-ignored) and run tofu through 1Password: op run --env-file=.env -- tofu apply
# Plain values work too, but then .env holds your Hetzner token in clear text.
HCLOUD_TOKEN="op://<vault>/<hetzner item>/token"
TF_VAR_ssh_public_key="op://<vault>/<ssh key item>/public key"
TF_VAR_laptop_ip=<your public IPv4>
